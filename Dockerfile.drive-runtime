# syntax=docker/dockerfile:1.7
FROM rust:1.90-bookworm AS builder
WORKDIR /src

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY inkbridge-convert ./inkbridge-convert
COPY inkbridge-broker ./inkbridge-broker
COPY inkbridge-cloud-runtime ./inkbridge-cloud-runtime
COPY inkbridge-drive-gateway ./inkbridge-drive-gateway
COPY inkbridge-drive-runtime ./inkbridge-drive-runtime
COPY inkbridge-folder-transport ./inkbridge-folder-transport
COPY inkbridge-boox-native ./inkbridge-boox-native

# Cargo resolves the whole inherited workspace even though this image builds
# only the Drive job and converter.
COPY build-dict ./build-dict
COPY device-eink ./device-eink
COPY inkread-daily ./inkread-daily
COPY inkread-dict ./inkread-dict
COPY inkread-epub ./inkread-epub
COPY inkread-ink ./inkread-ink
COPY inkread-lua ./inkread-lua
COPY inkread-pdftext ./inkread-pdftext
COPY inkread-update ./inkread-update
COPY reader-core ./reader-core

RUN cargo build --locked --release -p inkbridge-drive-runtime -p inkbridge-convert

FROM debian:trixie-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates qpdf \
    && qpdf_version="$(qpdf --version | awk 'NR == 1 { print $3 }')" \
    && dpkg --compare-versions "$qpdf_version" ge 12.2.0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/target/release/inkbridge-drive-runtime /usr/local/bin/inkbridge-drive-runtime
COPY --from=builder /src/target/release/inkbridge-convert /usr/local/bin/inkbridge-convert

USER 65532:65532
# Safe by default: a deployment must deliberately append --apply.
ENTRYPOINT ["/usr/local/bin/inkbridge-drive-runtime"]
